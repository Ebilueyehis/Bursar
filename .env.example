# Bursar environment variables — copy to .env.local and fill in.
# .env.local is gitignored. Never commit real keys.

# Public — safe in the browser (RLS protects the data).
# Supabase → Project Settings → Data API / API Keys.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx

# Secret — SERVER ONLY. Bypasses RLS. Never prefix with NEXT_PUBLIC.
# Supabase → Project Settings → API Keys → service_role.
SUPABASE_SERVICE_ROLE_KEY=

# Where the app is hosted (used to build OAuth redirect URLs).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
